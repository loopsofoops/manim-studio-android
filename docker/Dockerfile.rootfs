FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    VIRTUAL_ENV=/opt/atelier-venv \
    PATH="/opt/atelier-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    MPLBACKEND=Agg

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    bash \
    coreutils \
    findutils \
    sed \
    gawk \
    grep \
    tar \
    gzip \
    unzip \
    git \
    file \
    procps \
    locales \
    build-essential \
    pkg-config \
    meson \
    ninja-build \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    libcairo2-dev \
    libpango1.0-dev \
    libglib2.0-dev \
    libffi-dev \
    libjpeg-dev \
    zlib1g-dev \
    libfreetype6-dev \
    libpng-dev \
    ffmpeg \
    sox \
    fontconfig \
    fonts-dejavu-core \
    fonts-lmodern \
    fonts-stix \
    lmodern \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-science \
    texlive-xetex \
    dvisvgm \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen C.UTF-8 || true

RUN python3 -m venv /opt/atelier-venv && \
    /opt/atelier-venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel cython && \
    /opt/atelier-venv/bin/pip install --no-cache-dir --prefer-binary \
      numpy \
      scipy \
      sympy \
      matplotlib \
      pillow \
      networkx \
      rich \
      manim

RUN fc-cache -fv && mkdir -p /root/.matplotlib /workspace /user-site /outputs && \
    printf 'backend: Agg\nfigure.dpi: 180\nsavefig.dpi: 180\n' > /root/.matplotlib/matplotlibrc

RUN cat <<'PYEOF' > /usr/local/bin/atelier-run.py
#!/opt/atelier-venv/bin/python3
import os, runpy, sys, time

os.environ.setdefault("MPLBACKEND", "Agg")
plot_dir = "/outputs/plots"
os.makedirs(plot_dir, exist_ok=True)

try:
    import matplotlib
    matplotlib.use("Agg", force=True)
    import matplotlib.pyplot as plt
    _plot_counter = [0]

    def _atelier_show(*args, **kwargs):
        figs = [plt.figure(num) for num in plt.get_fignums()]
        for fig in figs:
            _plot_counter[0] += 1
            out_path = os.path.join(plot_dir, f"plot_{int(time.time() * 1000)}_{_plot_counter[0]}.png")
            fig.savefig(out_path, dpi=180, bbox_inches="tight")
            print(f"__ATELIER_ARTIFACT__:IMAGE:{out_path}", flush=True)
        plt.close("all")

    plt.show = _atelier_show
except Exception:
    pass

if len(sys.argv) < 2:
    print("Usage: atelier-run.py <script.py>", file=sys.stderr)
    sys.exit(2)

target = sys.argv[1]
sys.argv = sys.argv[1:]
sys.path.insert(0, os.path.dirname(os.path.abspath(target)))
runpy.run_path(target, run_name="__main__")
PYEOF

RUN cat <<'PYEOF' > /usr/local/bin/atelier-compile.py
#!/opt/atelier-venv/bin/python3
import ast, dis, os, py_compile, subprocess, sys, sysconfig

def main():
    args = sys.argv[1:]
    native_mode = "--native" in args
    files = [a for a in args if not a.startswith("--")]
    if not files:
        print("Usage: atelier-compile.py [--native] <file>", file=sys.stderr)
        sys.exit(2)
    path = files[0]
    with open(path, "r", encoding="utf-8") as f:
        src = f.read()

    if native_mode or path.endswith(".pyx"):
        print(f"=== Native Cython / GCC Compilation: {os.path.basename(path)} ===")
        out_dir = "/outputs/native"
        os.makedirs(out_dir, exist_ok=True)
        base = os.path.splitext(os.path.basename(path))[0]
        c_file = os.path.join(out_dir, f"{base}.c")
        so_file = os.path.join(out_dir, f"{base}{sysconfig.get_config_var('EXT_SUFFIX') or '.so'}")
        inc = sysconfig.get_path("include")
        subprocess.run(["cython", "-3", "-o", c_file, path], check=True)
        subprocess.run([
            "gcc", "-O3", "-shared", "-fPIC",
            f"-I{inc}", c_file, "-o", so_file
        ], check=True)
        size_kb = os.path.getsize(so_file) / 1024.0
        print(f"Compiled native extension: {so_file} ({size_kb:.1f} KB)")
        return

    print(f"=== AST & Syntax Verification: {os.path.basename(path)} ===")
    tree = ast.parse(src, filename=path)
    classes = [n.name for n in ast.walk(tree) if isinstance(n, ast.ClassDef)]
    funcs = [n.name for n in ast.walk(tree) if isinstance(n, ast.FunctionDef)]
    imports = []
    for n in ast.walk(tree):
        if isinstance(n, ast.Import):
            imports.extend(alias.name for alias in n.names)
        elif isinstance(n, ast.ImportFrom) and n.module:
            imports.append(n.module)

    print(f"Syntax: OK ({len(src.splitlines())} lines)")
    print(f"Imports ({len(set(imports))}): {', '.join(sorted(set(imports))) or 'none'}")
    print(f"Classes ({len(classes)}): {', '.join(classes) or 'none'}")
    print(f"Functions ({len(funcs)}): {', '.join(funcs) or 'none'}")

    pyc_out = os.path.join("/outputs", os.path.basename(path) + "c")
    os.makedirs("/outputs", exist_ok=True)
    py_compile.compile(path, cfile=pyc_out, doraise=True)
    print(f"Bytecode compiled: {pyc_out} ({os.path.getsize(pyc_out)} bytes)")
    print("\n=== CPython Bytecode Disassembly ===")
    code_obj = compile(src, path, "exec")
    dis.dis(code_obj)

if __name__ == "__main__":
    main()
PYEOF

RUN cat <<'PYEOF' > /usr/local/bin/atelier-repl.py
#!/opt/atelier-venv/bin/python3
import code, io, json, os, sys, time, traceback

os.environ.setdefault("MPLBACKEND", "Agg")
plot_dir = "/outputs/plots"
os.makedirs(plot_dir, exist_ok=True)
last_image = [None]

try:
    import matplotlib
    matplotlib.use("Agg", force=True)
    import matplotlib.pyplot as plt
    _idx = [0]

    def _repl_show(*args, **kwargs):
        for num in plt.get_fignums():
            _idx[0] += 1
            p = os.path.join(plot_dir, f"repl_{int(time.time() * 1000)}_{_idx[0]}.png")
            plt.figure(num).savefig(p, dpi=180, bbox_inches="tight")
            last_image[0] = p
        plt.close("all")

    plt.show = _repl_show
except Exception:
    pass

ns = {"__name__": "__main__"}
sys.stdout.write(json.dumps({"ready": True, "version": sys.version.split()[0]}) + "\n")
sys.stdout.flush()

for raw in sys.stdin:
    raw = raw.strip()
    if not raw:
        continue
    try:
        req = json.loads(raw)
    except Exception:
        continue
    if req.get("cmd") == "reset":
        ns.clear()
        ns["__name__"] = "__main__"
        sys.stdout.write(json.dumps({"ok": True, "stdout": "Session reset.", "stderr": "", "vars": [], "latex": "", "image": ""}) + "\n")
        sys.stdout.flush()
        continue

    snippet = req.get("code", "")
    buf_out, buf_err = io.StringIO(), io.StringIO()
    last_image[0] = None
    latex_str = ""
    ok = True
    old_out, old_err = sys.stdout, sys.stderr
    sys.stdout, sys.stderr = buf_out, buf_err
    try:
        try:
            compiled = compile(snippet, "<repl>", "eval")
            val = eval(compiled, ns)
            if val is not None:
                ns["_"] = val
                print(repr(val))
                try:
                    import sympy
                    if isinstance(val, sympy.Basic):
                        latex_str = sympy.latex(val)
                except Exception:
                    pass
        except SyntaxError:
            exec(compile(snippet, "<repl>", "exec"), ns)
    except Exception:
        ok = False
        traceback.print_exc(file=buf_err)
    finally:
        sys.stdout, sys.stderr = old_out, old_err

    var_list = []
    for k, v in sorted(ns.items()):
        if k.startswith("_") or (callable(v) and getattr(v, "__module__", "") != "__main__"):
            continue
        if isinstance(v, type(sys)):
            continue
        r = repr(v)
        if len(r) > 80:
            r = r[:77] + "..."
        var_list.append({"name": k, "type": type(v).__name__, "repr": r})

    resp = {
        "ok": ok,
        "stdout": buf_out.getvalue(),
        "stderr": buf_err.getvalue(),
        "vars": var_list[:40],
        "latex": latex_str,
        "image": last_image[0] or "",
    }
    sys.stdout.write(json.dumps(resp) + "\n")
    sys.stdout.flush()
PYEOF

RUN cat <<'PYEOF' > /usr/local/bin/atelier-probe.py
#!/opt/atelier-venv/bin/python3
import json, os, subprocess, sys

if len(sys.argv) < 2:
    sys.exit(1)
path = sys.argv[1]
cmd = [
    "ffprobe", "-v", "quiet", "-print_format", "json",
    "-show_format", "-show_streams", path
]
out = subprocess.check_output(cmd, text=True)
data = json.loads(out)
video = next((s for s in data.get("streams", []) if s.get("codec_type") == "video"), {})
rate = video.get("avg_frame_rate") or video.get("r_frame_rate") or "30/1"
try:
    num, den = rate.split("/")
    fps = float(num) / float(den) if float(den) != 0 else 30.0
except Exception:
    fps = 30.0
dur_s = float(data.get("format", {}).get("duration") or video.get("duration") or 0.0)
print(json.dumps({
    "width": int(video.get("width") or 0),
    "height": int(video.get("height") or 0),
    "fps": round(fps, 3),
    "durationMs": int(dur_s * 1000),
    "codec": str(video.get("codec_name") or "").upper(),
    "sizeBytes": os.path.getsize(path) if os.path.exists(path) else 0
}))
PYEOF

RUN chmod +x /usr/local/bin/atelier-*.py

# Mandatory End-to-End CI Smoke Test: Manim + MathTex + FFmpeg + pdflatex + Cython + GCC
RUN set -e && \
    python3 -c "import manim, numpy, scipy, sympy, matplotlib, PIL, networkx, Cython; print('PY_STACK_OK', manim.__version__)" && \
    cat <<'EOF' > /tmp/smoke_scene.py
from manim import *
class SmokeScene(Scene):
    def construct(self):
        eq = MathTex(r"e^{i\pi} + 1 = 0")
        self.play(Write(eq), run_time=0.5)
        self.wait(0.2)
EOF
    manim render -ql --disable_caching --media_dir /tmp/smoke_media /tmp/smoke_scene.py SmokeScene && \
    MP4_OUT="$(find /tmp/smoke_media/videos -name 'SmokeScene.mp4' | head -n 1)" && \
    test -s "$MP4_OUT" && \
    /usr/local/bin/atelier-probe.py "$MP4_OUT" && \
    cat <<'EOF' > /tmp/smoke.tex
\documentclass{article}
\usepackage{amsmath}
\begin{document}
\[\int_{-\infty}^{\infty} e^{-x^2}\,dx = \sqrt{\pi}\]
\end{document}
EOF
    pdflatex -interaction=nonstopmode -output-directory=/tmp /tmp/smoke.tex && \
    test -s /tmp/smoke.pdf && \
    cat <<'EOF' > /tmp/smoke_cy.pyx
def fast_sum(int n):
    cdef long s = 0
    cdef int i
    for i in range(n):
        s += i
    return s
EOF
    /usr/local/bin/atelier-compile.py --native /tmp/smoke_cy.pyx && \
    PYTHONPATH=/outputs/native python3 -c "import smoke_cy; assert smoke_cy.fast_sum(100) == 4950; print('CYTHON_OK')" && \
    rm -rf /tmp/smoke* /outputs/native /root/.cache/pip /root/.cache/manim
