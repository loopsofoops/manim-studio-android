FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    VIRTUAL_ENV=/opt/atelier-venv \
    PATH="/opt/atelier-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    MPLBACKEND=Agg

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    bash \
    coreutils \
    findutils \
    sed \
    gawk \
    grep \
    tar \
    gzip \
    unzip \
    git \
    file \
    procps \
    locales \
    build-essential \
    pkg-config \
    meson \
    ninja-build \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    libcairo2-dev \
    libpango1.0-dev \
    libglib2.0-dev \
    libffi-dev \
    libjpeg-dev \
    zlib1g-dev \
    libfreetype6-dev \
    libpng-dev \
    ffmpeg \
    sox \
    fontconfig \
    fonts-dejavu-core \
    fonts-lmodern \
    fonts-stix \
    lmodern \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-science \
    texlive-xetex \
    dvisvgm \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen C.UTF-8 || true

RUN python3 -m venv /opt/atelier-venv && \
    /opt/atelier-venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel cython && \
    /opt/atelier-venv/bin/pip install --no-cache-dir --prefer-binary \
      numpy \
      scipy \
      sympy \
      matplotlib \
      pillow \
      networkx \
      rich \
      manim

RUN fc-cache -fv && mkdir -p /root/.matplotlib /workspace /user-site /outputs && \
    printf 'backend: Agg\nfigure.dpi: 180\nsavefig.dpi: 180\n' > /root/.matplotlib/matplotlibrc

COPY docker/bin/ /usr/local/bin/

RUN chmod +x /usr/local/bin/atelier-*.py /usr/local/bin/smoke-test.sh && \
    /usr/local/bin/smoke-test.sh && \
    rm -f /usr/local/bin/smoke-test.sh
